{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WM Tapper",
  "version": "1.0.0",
  "identifier": "com.whtmst.wm-tapper",
  "build": {
    "beforeBuildCommand": "npm run prepare:frontend",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "WM Tapper",
        "width": 250,
        "height": 300,
        "resizable": false,
        "decorations": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
